{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archiver",
  "version": "0.1.0",
  "identifier": "app.archiver.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1439",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Archiver · Archivist",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 400,
        "backgroundColor": "#191f1c"
      },
      {
        "label": "quick",
        "title": "Archiver · Librarian",
        "url": "index.html?quick=1",
        "width": 480,
        "height": 720,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#191f1c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false },
  "plugins": { "updater": { "pubkey": "", "endpoints": [] } }
}
